/**
 * Implements hook_preprocess_paragraph() to compute delta for child items.
 */
function drupify_preprocess_paragraph__drupify_process_item(&$variables) {
  drupify_drupify_paragraph_delta($variables);
}

function drupify_preprocess_paragraph__drupify_why_item(&$variables) {
  drupify_drupify_paragraph_delta($variables);
}

function drupify_preprocess_paragraph__drupify_pricing_item(&$variables) {
  drupify_drupify_paragraph_delta($variables);
}

function drupify_preprocess_paragraph__drupify_testimonial_item(&$variables) {
  drupify_drupify_paragraph_delta($variables);
}

function drupify_preprocess_paragraph__drupify_faq_item(&$variables) {
  drupify_drupify_paragraph_delta($variables);
}

function drupify_drupify_paragraph_delta(&$variables) {
  $variables['delta'] = NULL;
  $parent = $variables['paragraph']->getParentEntity();
  if ($parent && $parent->hasField('field_reference_sections')) {
    foreach ($parent->get('field_reference_sections')->getValue() as $d => $item) {
      if ($item['target_id'] === $variables['paragraph']->id()) {
        $variables['delta'] = $d;
        break;
      }
    }
  }
}

/**
 * Implements hook_preprocess_block().
 */
function drupify_preprocess_block(&$variables) {
  // Check if the block has content.field_resume.
  if (isset($variables['content']['field_resume']) && !empty($variables['content']['field_resume']['#items'])) {
    $media = $variables['content']['field_resume']['#items'][0]->entity;
    if ($media && $media->hasField('field_media_file')) {
      $file = $media->field_media_file->entity;
      if ($file) {
        $file_url = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        $variables['resume_url'] = $file_url;
      }
    }
  }
}
