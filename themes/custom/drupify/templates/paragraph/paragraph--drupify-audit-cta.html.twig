{#
/**
 * @file paragraph--drupify-audit-cta.html.twig
 * Free Drupal audit band.
 */
#}
<section class="drupify-audit-band" id="audit" aria-labelledby="audit-title">
  <div class="drupify-container drupify-audit-inner">
    <div>
      <p class="drupify-eyebrow">{{ paragraph.field_eyebrow.value ?: 'Free Drupal audit'|t }}</p>
      <h2 id="audit-title">{{ paragraph.field_title.value }}</h2>
      {% if paragraph.field_description.value %}
        <p>{{ paragraph.field_description.value }}</p>
      {% endif %}
      {% if paragraph.field_items.value %}
        <ul class="drupify-audit-list">
          {% for item in paragraph.field_items.value|split('\n') %}
            {% if item|trim %}
              <li>{{ item|trim }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>
    {% if paragraph.field_link_title.value %}
      <a class="drupify-button drupify-button-light" href="{{ paragraph.field_link_url.value }}">{{ paragraph.field_link_title.value }}</a>
    {% endif %}
  </div>
</section>
