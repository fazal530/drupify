{#
/**
 * @file paragraph--drupify-testimonials.html.twig
 * Testimonials section.
 */
#}
<section class="drupify-section drupify-muted" aria-labelledby="testimonials-title">
  <div class="drupify-container">
    <div class="drupify-section-head">
      <p class="drupify-eyebrow">{{ content.field_eyebrow ?: 'Testimonials'|t }}</p>
      <h2 id="testimonials-title">{{ content.field_title }}</h2>
    </div>
    <div class="drupify-testimonial-grid">
      {{ content.field_reference_sections }}
    </div>
  </div>
</section>