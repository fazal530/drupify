{#
/**
 * @file paragraph--drupify-services.html.twig
 * Services section.
 */
#}
<section class="drupify-section drupify-muted" id="services" aria-labelledby="services-title">
  <div class="drupify-container">
    <div class="drupify-section-head">
      <p class="drupify-eyebrow">{{ paragraph.field_eyebrow.value ?: 'Drupal services'|t }}</p>
      <h2 id="services-title">{{ paragraph.field_title.value }}</h2>
      {% if paragraph.field_description.value %}
        <p>{{ paragraph.field_description.value }}</p>
      {% endif %}
    </div>
    {% if drupify_services %}
      <div class="drupify-service-grid">
        {% for service in drupify_services %}
          <article>
            <span>{{ service.category ?: 'Drupal service'|t }}</span>
            <h3>{{ service.title }}</h3>
            <p>{{ service.summary }}</p>
            <div class="drupify-card-actions">
              <a class="drupify-text-link" href="{{ service.url }}">{{ 'View service'|t }}</a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
