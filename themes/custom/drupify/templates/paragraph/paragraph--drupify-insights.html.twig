{#
/**
 * @file paragraph--drupify-insights.html.twig
 * Insights section.
 */
#}
<section class="drupify-section" id="insights" aria-labelledby="insights-title">
  <div class="drupify-container">
    <div class="drupify-section-head">
      <p class="drupify-eyebrow">{{ content.field_eyebrow ?: 'Insights'|t }}</p>
      <h2 id="insights-title">{{ content.field_title }}</h2>
    </div>
    <div class="drupify-insight-list">
      {% for blog in drupify_blogs|slice(0, 3) %}
        <article>
          <span>{{ blog.category ?: 'Drupal'|t }}</span>
          <h3>{{ blog.title }}</h3>
          <p>{{ blog.summary }}</p>
          <a class="drupify-text-link" href="{{ blog.url }}">{{ 'Read article'|t }}</a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>