{#
/**
 * @file paragraph--drupify-process.html.twig
 * Migration & upgrade expertise section.
 */
#}
<section class="drupify-section" aria-labelledby="migration-title">
  <div class="drupify-container drupify-split">
    <div class="drupify-section-head drupify-align-start">
      <p class="drupify-eyebrow">{{ paragraph.field_eyebrow.value ?: 'Migration & upgrade expertise'|t }}</p>
      <h2 id="migration-title">{{ paragraph.field_title.value }}</h2>
      {% if paragraph.field_description.value %}
        <p>{{ paragraph.field_description.value }}</p>
      {% endif %}
    </div>
    <ol class="drupify-process-list">
      {{ content.field_reference_sections }}
    </ol>
  </div>
</section>
