{{ attach_library('drupify/drupify_homepage') }}

<div class="drupify-home drupify-blog-detail-page drupify-career-detail-page" id="page-wrapper">
  <a class="drupify-skip-link" href="#main-content">{{ 'Skip to main content'|t }}</a>

  {% include '@drupify/includes/drupify-header.html.twig' %}

  <main id="main-content" tabindex="-1">
    <article>
      <header class="drupify-page-hero drupify-section">
        <div class="drupify-container drupify-narrow">
          <p class="drupify-eyebrow">{{ 'Open role'|t }}</p>
          <h1>{{ drupify_job.title }}</h1>
          {% if drupify_job.summary %}
            <p class="drupify-lead">{{ drupify_job.summary }}</p>
          {% endif %}
          {% if drupify_job.meta %}
            <dl class="drupify-meta-list">
              {% for item in drupify_job.meta %}
                <div><dt>{{ item.title }}</dt><dd>{{ item.value }}</dd></div>
              {% endfor %}
            </dl>
          {% endif %}
        </div>
      </header>

      <section class="drupify-section">
        <div class="drupify-container drupify-article-layout">
          <div class="drupify-article-body">
            {% if drupify_job.description %}
              {{ drupify_job.description|raw }}
            {% endif %}

            {% if drupify_job.responsibilities %}
              <h2>{{ drupify_job.responsibilities_title }}</h2>
              <ol>
                {% for item in drupify_job.responsibilities %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ol>
            {% endif %}
          </div>

          <aside class="drupify-article-aside" aria-label="{{ 'Apply for this role'|t }}">
            <div>
              <span>{{ drupify_job.apply_title }}</span>
              <p>{{ 'Upload your CV and tell us why you would be a good fit for this role.'|t }}</p>
              {% if drupify_job_form %}
                {{ drupify_job_form }}
              {% else %}
                <a class="drupify-button drupify-button-primary" href="{{ base_path }}contact-us">{{ 'Contact us about this role'|t }}</a>
              {% endif %}
            </div>
          </aside>
        </div>
      </section>
    </article>

    <section class="drupify-section drupify-muted" aria-labelledby="more-role-title">
      <div class="drupify-container">
        <div class="drupify-section-head">
          <p class="drupify-eyebrow">{{ 'Open roles'|t }}</p>
          <h2 id="more-role-title">{{ 'More roles at Drupify.'|t }}</h2>
        </div>
        <div class="drupify-service-grid drupify-service-page-grid">
          {% for career in drupify_careers %}
            {% if career.id != node.id() %}
              <article>
                <span>{{ 'Full time'|t }}</span>
                <h3>{{ career.title }}</h3>
                <p>{{ career.summary ?: 'Join Drupify and help clients ship dependable Drupal work.'|t }}</p>
                <a class="drupify-text-link" href="{{ career.url }}">{{ 'View role'|t }}</a>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="drupify-audit-band" aria-labelledby="career-cta-title">
      <div class="drupify-container drupify-audit-inner">
        <div>
          <p class="drupify-eyebrow">{{ 'Not the right role?'|t }}</p>
          <h2 id="career-cta-title">{{ 'Get Drupal help instead of a Drupal job.'|t }}</h2>
          <p>{{ 'If you need a partner for delivery, Drupify can review your site and recommend a fix, upgrade, theme, or support path.'|t }}</p>
          <ul class="drupify-audit-list">
            <li>{{ 'Free technical review'|t }}</li>
            <li>{{ 'No-pressure advice'|t }}</li>
            <li>{{ 'Recommend a path'|t }}</li>
          </ul>
        </div>
        <a class="drupify-button drupify-button-light" href="{{ base_path }}contact-us">{{ 'Talk to Drupify'|t }}</a>
      </div>
    </section>
  </main>

  {% include '@drupify/includes/drupify-footer.html.twig' %}
</div>