{{ attach_library('drupify/drupify_homepage') }}

<div class="drupify-home drupify-blog-page" id="page-wrapper">
  <a class="drupify-skip-link" href="#main-content">{{ 'Skip to main content'|t }}</a>

  {% include '@drupify/includes/drupify-header.html.twig' %}

  <main id="main-content" tabindex="-1">
    <section class="drupify-page-hero drupify-section">
      <div class="drupify-container drupify-page-hero-grid">
        <div>
          <p class="drupify-eyebrow">{{ 'Drupal insights'|t }}</p>
          <h1>{{ 'Practical Drupal thinking for teams planning better websites.'|t }}</h1>
          <p class="drupify-lead">{{ 'Articles from Drupify on Drupal development, upgrades, web design, security, performance, and maintainable delivery.'|t }}</p>
          <div class="drupify-actions">
            <a class="drupify-button drupify-button-primary" href="{{ base_path }}contact-us">{{ 'Request Drupal audit'|t }}</a>
            <a class="drupify-button drupify-button-secondary" href="{{ base_path }}services">{{ 'Explore services'|t }}</a>
          </div>
        </div>

        <div class="drupify-service-overview drupify-blog-overview">
          <span>{{ 'Knowledge areas'|t }}</span>
          <ol>
            <li>{{ 'Drupal development standards'|t }}</li>
            <li>{{ 'Updates, migrations, and version planning'|t }}</li>
            <li>{{ 'Drupal theming and web design'|t }}</li>
            <li>{{ 'Performance, security, and maintainability'|t }}</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="drupify-section">
      <div class="drupify-container drupify-blog-view-head">
        <div class="drupify-section-head">
          <p class="drupify-eyebrow">{{ 'Article library'|t }}</p>
          <h2>{{ 'Drupal articles from the Drupify blog.'|t }}</h2>
          <p>{{ 'Browse practical writing on Drupal upgrades, frontend quality, performance, security, and maintainable delivery.'|t }}</p>
        </div>

        <div class="drupify-blog-list">
          {% for blog in drupify_blogs %}
            <article>
              <div class="drupify-blog-list-media">
                {% if blog.image %}
                  <img src="{{ blog.image }}" alt="{{ blog.image_alt }}">
                {% endif %}
              </div>
              <div>
                <time datetime="{{ blog.date_iso }}">{{ blog.date_label }}</time>
                <h3><a href="{{ blog.url }}">{{ blog.title }}</a></h3>
                <p>{{ blog.summary }}</p>
                <a class="drupify-text-link" href="{{ blog.url }}">{{ 'Read article'|t }}</a>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="drupify-section drupify-muted" aria-labelledby="blog-cta-title">
      <div class="drupify-container drupify-audit-inner">
        <div>
          <p class="drupify-eyebrow">{{ 'Free Drupal audit'|t }}</p>
          <h2 id="blog-cta-title">{{ 'Reading about Drupal issues because your own site has one?'|t }}</h2>
          <p>{{ 'Send the site and the problem. Drupify can recommend whether you need a quick fix, upgrade plan, redesign, migration, or support path.'|t }}</p>
          <ul class="drupify-audit-list">
            <li>{{ 'Version risk'|t }}</li>
            <li>{{ 'Theme issues'|t }}</li>
            <li>{{ 'Performance review'|t }}</li>
          </ul>
        </div>
        <a class="drupify-button drupify-button-light" href="{{ base_path }}contact-us">{{ 'Request Drupal audit'|t }}</a>
      </div>
    </section>
  </main>

  {% include '@drupify/includes/drupify-footer.html.twig' %}
</div>