{{ attach_library('drupify/drupify_homepage') }}

{% set service_id = node.id() ~ '' %}
{% set service_map = {
  '4': {
    eyebrow: 'Drupal development service',
    headline: 'Custom Drupal development for platforms that need more than off-the-shelf features.',
    lead: 'Drupify builds custom Drupal modules, integrations, workflows, and backend features around your business logic and editorial needs.',
    primary: 'Request development audit',
    overview_label: 'Development priorities',
    priorities: ['Understand business logic and content workflow', 'Build maintainable custom Drupal functionality', 'Integrate APIs, tools, and third-party systems', 'Test, document, and support future changes'],
    intro_title: 'Custom Drupal development should make the platform easier to run, not harder to maintain.',
    bullets: ['Custom module development', 'API and third-party integrations', 'Editorial workflow improvements', 'Performance, security, and maintainability review'],
    risk_title: 'Good custom development prevents future technical debt.',
    process_title: 'A development process built around clarity, implementation, and maintainability.',
    cta_eyebrow: 'Development audit',
    cta_title: 'Before you build, know what Drupal should own.',
    cta: 'Request development audit'
  },
  '7': {
    eyebrow: 'Drupal commerce service',
    headline: 'Drupal e-commerce systems built for flexible content, catalog, and checkout needs.',
    lead: 'Drupify helps teams plan and build Drupal-powered commerce experiences with structured content, integrations, and maintainable frontend delivery.',
    primary: 'Request commerce audit',
    overview_label: 'Commerce priorities',
    priorities: ['Map products, content, and buyer journeys', 'Plan checkout, payment, and integration needs', 'Build reusable Drupal commerce components', 'Test performance, forms, and conversion paths'],
    intro_title: 'Commerce websites need reliable structure behind the buying experience.',
    bullets: ['Product and content architecture', 'Checkout and payment planning', 'Commerce integrations', 'Responsive frontend and conversion QA'],
    risk_title: 'A commerce build must protect trust, speed, and manageability.',
    process_title: 'A commerce process focused on content, checkout, and operational confidence.',
    cta_eyebrow: 'Commerce audit',
    cta_title: 'Before you rebuild commerce, know where conversion and operations can break.',
    cta: 'Request commerce audit'
  },
  '8': {
    eyebrow: 'Drupal theming service',
    headline: 'Drupal theming and frontend systems that make your brand easier to use.',
    lead: 'Drupify designs and implements responsive Drupal themes with Twig, libraries, components, accessibility checks, and clean editor-friendly structure.',
    primary: 'Request theme audit',
    overview_label: 'Theme priorities',
    priorities: ['Translate brand direction into reusable sections', 'Build Twig templates and Drupal libraries cleanly', 'Support responsive, accessible page layouts', 'Test forms, menus, Views, and editor output'],
    intro_title: 'A Drupal theme should look polished and stay editable.',
    bullets: ['Custom Drupal theme implementation', 'Twig template and component cleanup', 'Responsive design QA', 'Frontend accessibility and performance polish'],
    risk_title: 'Visual polish fails when templates, fields, and editor output are not planned together.',
    process_title: 'A theming process built around design accuracy, Drupal structure, and QA.',
    cta_eyebrow: 'Theme audit',
    cta_title: 'Before you redesign, know what the current theme is doing.',
    cta: 'Request theme audit'
  },
  '9': {
    eyebrow: 'Drupal migration service',
    headline: 'Move to modern Drupal without losing content, SEO, or launch confidence.',
    lead: 'Drupify plans and executes Drupal upgrades and migrations with careful content mapping, module review, theme adaptation, testing, and post-launch support.',
    primary: 'Request migration audit',
    overview_label: 'Migration priorities',
    priorities: ['Preserve content and URL structure', 'Review modules, custom code, and integrations', 'Adapt themes for modern Drupal', 'Test, launch, monitor, and support'],
    intro_title: 'Migration is not only a version change. It is a controlled release.',
    bullets: ['Drupal 7, 8, 9, or 10 upgrade planning', 'Content model and field mapping', 'Module replacement and compatibility review', 'Theme, SEO, redirect, QA, and launch support'],
    risk_title: 'The page should answer the fears clients actually have.',
    process_title: 'A migration process built around planning, mapping, and validation.',
    cta_eyebrow: 'Migration audit',
    cta_title: 'Before you migrate, know what could break.',
    cta: 'Request migration audit'
  },
  '143': {
    eyebrow: 'Drupal support service',
    headline: 'Ongoing Drupal support for stable, secure, and maintainable websites.',
    lead: 'Drupify helps teams keep Drupal sites healthy with updates, troubleshooting, performance checks, frontend fixes, and practical maintenance planning.',
    primary: 'Request support audit',
    overview_label: 'Support priorities',
    priorities: ['Review the current Drupal health and update status', 'Fix bugs across theme, modules, Views, forms, and content', 'Maintain Composer, security releases, and configuration safely', 'Plan small improvements before they become bigger problems'],
    intro_title: 'Drupal support should keep your site dependable between major projects.',
    bullets: ['Security updates and Composer maintenance', 'Theme, module, Views, and form troubleshooting', 'Performance, cache, and frontend quality checks', 'Monthly support planning and upgrade readiness'],
    risk_title: 'Support work protects trust, uptime, editing workflows, and future upgrade paths.',
    process_title: 'A support process built around health checks, practical fixes, and steady maintenance.',
    cta_eyebrow: 'Support audit',
    cta_title: 'Before support becomes urgent, know what needs attention.',
    cta: 'Request support audit'
  }
