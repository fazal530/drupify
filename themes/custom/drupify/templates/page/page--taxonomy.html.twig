{{ attach_library('drupify/drupify_homepage') }}

<div class="drupify-home drupify-taxonomy-page" id="page-wrapper">
  <a class="drupify-skip-link" href="#main-content">{{ 'Skip to main content'|t }}</a>

  {% include '@drupify/includes/drupify-header.html.twig' %}

  <main id="main-content" tabindex="-1">
    <section class="drupify-page-hero drupify-section">
      <div class="drupify-container">
        <p class="drupify-eyebrow">{{ 'Drupify blog'|t }}</p>
        <h1>{{ page.title }}</h1>
        <p class="drupify-lead">{{ 'Articles, tutorials, and updates filed under this topic.'|t }}</p>
      </div>
    </section>

    <section class="drupify-section">
      <div class="drupify-container">
        {{ page.content }}
      </div>
    </section>
  </main>

  {% include '@drupify/includes/drupify-footer.html.twig' %}
</div>