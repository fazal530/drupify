<section class="careers-details section">
        <div class="container">
            <div class="content">
                <div class="job-overview aos-init aos-animate" data-aos="fade-up" data-aos-duration="800">
                    <div class="pages-title">
                        <span>{{ content.field_tag_line.0 }}</span>
                        <h2>{{ content.field_sub_title.0 }}</h2>
                    </div>
                    {{ content.field_job_description.0 }}
                </div>
                <hr>
                <div class="job-responsibilities aos-init aos-animate" data-aos="fade-out" data-aos-duration="1000">
                    {{ content.field_job_responsibilities }}
                    {{ content.field_job_details }}
                    {{ content.field_cv_upload }}
                </div>
            </div>
        </div>
    </section>
    