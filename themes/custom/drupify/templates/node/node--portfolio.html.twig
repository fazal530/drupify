        <div class="container image">
        <img class="aos-init aos-animate" data-aos="fade-out" data-aos-duration="1000" src="{{ file_url(content.field_image['#items'].entity.uri.value) }}" alt="{{content.field_image['#items'].alt}}">
        </div>
        <div class="about section ">
            <div class="container">
                <div class="item">
                    <div class="row gy-3">
                        <div class="col-lg-9  col-12 portfolio-side-1 aos-init aos-animate" data-aos="fade-up" data-aos-duration="1000">
                            <div class="content">
                                {{ content.body.0 }}
                            </div>
                        </div>
                        <div class="col-lg-3 col-12 portfolio-side-2 portfolio-about aos-init aos-animate" data-aos="fade-up" data-aos-duration="1000">
                            <div class="about-details ">
                                <div class="list">
                                    <h5>{{ content.field_caption_1.0 }}:</h5>
                                    <span>{{ content.field_caption_content_1.0 }}</span>
                                </div>
                                <div class="list">
                                    <h5>{{ content.field_caption_2.0 }}:</h5>
                                    <span>{{ content.field_caption_content_2.0 }}</span>
                                </div>
                                 {% if content.field_portfolio_category[0] %} 
                                    <div class="list">
                                        <h5>CATEGORY: </h5>
                                        {% for key,value in content.field_portfolio_category['#items'] %}
                                            {%	if  key == 0  %}
                                                <span>{{ content.field_portfolio_category[key]['#title'] }}</span>
                                            {% else %}
                                                <span>{{ content.field_portfolio_category[key]['#title'] }}</span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                 {% endif %} 
                                <div class="list">
                                    <h5>SHARE: </h5>
                                    {{share}}
                                </div>
                                {%	if  content.field_website_link	[0]  %}
                                <a href="{{ content.field_website_link.0['#url'] }}" class="visit-link">{{ content.field_website_link.0['#title'] }}
                                    <svg xmlns="http://www.w3.org/2000/svg" width="59.461" height="41" viewBox="0 0 59.461 41">
                                        <path data-name="Icon ionic-ios-arrow-round-forward" d="M45.157,12.018a2.772,2.772,0,0,0-.02,3.833L57.483,28.537H10.494a2.71,2.71,0,0,0,0,5.416H57.463L45.117,46.64a2.793,2.793,0,0,0,.02,3.833,2.582,2.582,0,0,0,3.716-.021l16.732-17.29h0a3.049,3.049,0,0,0,.548-.854,2.643,2.643,0,0,0,.2-1.042,2.752,2.752,0,0,0-.751-1.9L48.853,12.08A2.541,2.541,0,0,0,45.157,12.018Z" transform="translate(-7.375 -10.752)" fill="#fff" stroke="#fff" stroke-width="1"></path>
                                    </svg>
                                </a>
                                {% endif %}
                            </div>
                        </div>
                         <div class="col-lg-9  col-12 portfolio-side-1 aos-init aos-animate" data-aos="fade-up" data-aos-duration="1000">
                            <div class="content">
                                {{ content.field_sections }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        