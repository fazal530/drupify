
<section class="drupify-search-results" aria-live="polite">
  {% if keyword %}
    <div class="drupify-search-summary">
      <h2>{{ 'Results for “@keyword”'|t({'@keyword': keyword}) }}</h2>
      <p>{{ '@count results found'|t({'@count': total_items_count}) }}</p>
    </div>
  {% endif %}
  <div class="wrapper region region-content">
    {% if title is not empty %}
      <h2>{{ title }}</h2>
    {% endif %}
    {% if items %}
      <ol class="search-list node-results">
        {% for item in items %}
          {{ item.value }}
        {% endfor %}
      </ol>
    {% else %}
      {{ empty }}
    {% endif %}
  </div>
</section>
