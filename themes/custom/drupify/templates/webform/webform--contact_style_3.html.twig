 <form {{ attributes }}>
    <div class="row">
        <div class="col-12 col-md-6 col-lg-6">
            {{ element.elements.name }}
        </div>
        <div class="col-12 col-md-6 col-lg-6">
            {{ element.elements.email }}
        </div>
    </div>
    <div class="form-group">
        {{ element.elements.message }}
    </div>
    {{ element.elements.actions }}
    <div>
        {{ element.form_token }}
        {{ element.form_build_id }}
        {{ element.form_id }}
    </div>
</form>