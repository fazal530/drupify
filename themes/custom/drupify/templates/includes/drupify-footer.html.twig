{% set asset_base = base_path ~ 'sites/default/files' %}

<footer class="drupify-site-footer">
  <div class="drupify-container drupify-footer-grid">
    <div class="drupify-footer-brand">
      <img src="{{ asset_base }}/2024-07/Drupify-logo.png" alt="Drupify">
      <p>{{ 'Drupal development, migration, upgrade, and support for teams that need dependable engineering.'|t }}</p>
    </div>

    <nav aria-label="{{ 'Footer services'|t }}">
      <h2>{{ 'Services'|t }}</h2>
      {% for item in drupify_layout.footer.services %}
        <a href="{{ item.url }}">{{ item.title }}</a>
      {% endfor %}
    </nav>

    <nav aria-label="{{ 'Footer industries'|t }}">
      <h2>{{ 'Industries'|t }}</h2>
      <a href="{{ base_path }}industry/healthcare">{{ 'Healthcare'|t }}</a>
      <a href="{{ base_path }}industry/education">{{ 'Education'|t }}</a>
      <a href="{{ base_path }}service/ecommerce">{{ 'E-commerce'|t }}</a>
      <a href="{{ base_path }}industry/agencies">{{ 'Agencies'|t }}</a>
    </nav>

    <nav aria-label="{{ 'Footer company'|t }}">
      <h2>{{ 'Company'|t }}</h2>
      {% for item in drupify_layout.footer.company %}
        <a href="{{ item.url }}">{{ item.title }}</a>
      {% endfor %}
    </nav>

    <nav aria-label="{{ 'Footer resources'|t }}">
      <h2>{{ 'Resources'|t }}</h2>
      {% for item in drupify_layout.footer.resources %}
        <a href="{{ item.url }}">{{ item.title }}</a>
      {% endfor %}
    </nav>
  </div>

  <div class="drupify-container drupify-footer-bottom">
    <span>{{ '© 2026 Drupify. Drupal development, migration, and support services.'|t }}</span>
    <span>{{ 'Contact:'|t }} <a href="mailto:info@drupify.com">info@drupify.com</a></span>
  </div>
</footer>
